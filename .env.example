# کلید GapGPT (از secret/key.md؛ هرگز در گیت)
GAPGPT_API_KEY=
# مدل‌ها (فهرست: npm run agent:models)
TRIAGE_MODEL=gpt-5.4-mini
WRITER_MODEL=gpt-6-luna
WRITER_MODEL_TOP=claude-opus-5-5
TOP_IMPORTANCE=9
TOP_PER_DAY=2
MONTHLY_BUDGET_SOFT=7
MONTHLY_BUDGET_HARD=10
FALLBACK_MODEL=claude-haiku-5-5
# سهمیه و آستانه
PER_RUN=4
PER_DAY=15
MIN_IMPORTANCE=6
MAX_AGE_HOURS=36
# قاعده‌ی کارفرما: بدون نیم‌فاصله
NO_ZWNJ=true
# فقط روی سرور: انتشار خودکار
GIT_PUSH=false
DEPLOY_CMD=
INDEXNOW_KEY=
# شناسه‌ی Umami (umami.6fx.ir) — در بیلد خوانده می‌شود
PUBLIC_UMAMI_ID=
QUIET_BELOW=8
MIN_IMPORTANCE_QUIET=5
